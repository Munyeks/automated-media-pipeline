# Konfigurasi File & Folder
URL_FILE=urls.txt
DOWNLOAD_DIR=downloads

# Konfigurasi Jaringan & Timeout
TIMEOUT_MS=60000
SCAN_TIMEOUT_SEC=180

# Konfigurasi Auto-Retry
MAX_RETRIES=3
RETRY_DELAY_SEC=10

# Konfigurasi Unduhan
# Kosongkan untuk kecepatan penuh; contoh batas per unduhan: 2M
DOWNLOAD_LIMIT_RATE=
CONCURRENT_FRAGMENTS=8
MAX_CONCURRENT_DOWNLOADS=1

# (Opsional) Ambil cookies dari browser jika butuh login akun (chrome, edge, firefox, dll)
BROWSER_COOKIES=

# Mode interaktif jika video belum terdeteksi di latar belakang (misal butuh lewati captcha/klik play)
ENABLE_INTERACTIVE_FALLBACK=true
INTERACTIVE_TIMEOUT_SEC=60

# (Opsional) Proxy jika situs diblokir provider (contoh: http://127.0.0.1:7890 atau socks5://127.0.0.1:1080)
PROXY=
